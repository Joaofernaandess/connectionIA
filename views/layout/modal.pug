div#modal.modal.fade(tabindex="-1", role="dialog", aria-labelledby="modal", aria-hidden="true")
    div.modal-dialog.modal-dialog-centered(role="document")
        div.modal-content
            div.modal-header
                h5#title.modal-title
                button.close(type="button", data-dismiss="modal", aria-label="Close")
                    span(aria-hidden="true") &times;
        
            div.modal-body

            div.modal-footer
                button#btnCancelar.btn.btn-secondary(type="button", data-dismiss="modal")
                button#btnSalvar.btn.btn-primary(type="button")