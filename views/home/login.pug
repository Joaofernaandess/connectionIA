extends ../layout/layout

block vars
    - var pageTitle= "SommusBliP - Login"
    - var login = true

block content
    div.container-fluid
        div.theme-selector-floating
            div.dropdown.theme-dropdown
                button#themePreferenceButton.btn.btn-link.dropdown-toggle(type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Alterar tema")
                    span#themePreferenceIcon.theme-icon(role="presentation")
                    span#themePreferenceLabel Tema
                div#themePreferenceMenu.dropdown-menu.dropdown-menu-right(aria-labelledby="themePreferenceButton")
                    button.dropdown-item.theme-option(type="button" data-theme-option="light" onclick="setThemePreference('light')")
                        span.theme-option-icon(role="presentation") ☀️
                        span Tema claro
                    button.dropdown-item.theme-option(type="button" data-theme-option="dark" onclick="setThemePreference('dark')")
                        span.theme-option-icon(role="presentation") 🌙
                        span Tema escuro
                    button.dropdown-item.theme-option(type="button" data-theme-option="system" onclick="setThemePreference('system')")
                        span.theme-option-icon(role="presentation") 🖥️
                        span Tema do sistema
        div.row.full-screen.bg-light
            div.col

            div.col-12.col-xl-3.col-lg-4.col-md-4.col-sm-6.align-self-center
                div.card
                    div.card-header.text-center.logo-login
                        img(src="./app/imagens/logo.png")
                    div.card-body
                        div.form-group
                            label(for="email") E-mail
                            input#email.form-control(type="email", aria-describedby="emailHelp", onkeypress="loginKeyPress(event)", autofocus)
                            //- small#emailHelp.form-text.text-muted Por favor informe o email corretamente
                        div.form-group
                            label(for="password") Senha
                            input#password.form-control(type="password", onkeypress="loginKeyPress(event)")
                    div.card-footer
                        button.btn.btn-block.btn-primary(onclick="login()") Entrar

            div.col
        
    
